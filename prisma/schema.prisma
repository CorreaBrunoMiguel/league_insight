generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchResult {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum DatasetType {
  HISTORICAL
  CURRENT_SEASON
}

enum DatasetStatus {
  PENDING
  OK
  FAILED
}

model AppInit {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model League {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons Season[]
  teams   Team[]
  Dataset Dataset[]
}

model Season {
  id        Int       @id @default(autoincrement())
  leagueId  Int
  league    League    @relation(fields: [leagueId], references: [id])
  year      Int
  name      String
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
  dataset Dataset[]

  standings StandingSnapshot[]
}

model Team {
  id        Int     @id @default(autoincrement())
  name      String
  shortName String?
  code      String? @unique
  country   String?
  state     String?

  leagueId Int?
  league   League? @relation(fields: [leagueId], references: [id])

  homeMatches Match[] @relation("HomeMatches")
  awayMatches Match[] @relation("AwayMatches")

  standings StandingSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id       Int    @id @default(autoincrement())
  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  homeTeamId Int
  homeTeam   Team @relation("HomeMatches", fields: [homeTeamId], references: [id])

  awayTeamId Int
  awayTeam   Team @relation("AwayMatches", fields: [awayTeamId], references: [id])

  round     Int
  matchDate DateTime

  homeGoals Int
  awayGoals Int

  result MatchResult

  datasetId Int?
  dataset   Dataset? @relation(fields: [datasetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, round, homeTeamId, awayTeamId])
  @@index([seasonId, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model Dataset {
  id     Int           @id @default(autoincrement())
  source String // ex.: "api_xpto", "csv_cbf"
  type   DatasetType
  status DatasetStatus @default(PENDING)

  leagueId Int?
  league   League? @relation(fields: [leagueId], references: [id])

  seasonId Int?
  season   Season? @relation(fields: [seasonId], references: [id])

  ingestedAt DateTime? // quando a ingestão terminou
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  matches Match[]
}

model StandingSnapshot {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  round Int

  points Int
  played Int
  wins   Int
  draws  Int
  losses Int

  goalsFor     Int
  goalsAgainst Int
  goalDiff     Int

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, round, teamId])
  @@index([seasonId, round])
  @@index([teamId])
}

model FeatureSchema {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique // ex.: "v1_basica"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
